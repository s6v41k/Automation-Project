# Copy this file to .env and fill in real values. .env is gitignored.

# MySQL
DB_ROOT_PASSWORD=changeme
DB_NAME=loopcasts
DB_USER=loopcasts
DB_PASSWORD=changeme

# Backend (FastAPI)
JWT_SECRET=changeme
INTERNAL_API_KEY=changeme

# Frontend (Vue)
VITE_API_BASE_URL=http://localhost:8000

# Mail — Mailpit is our throwaway catcher, no real email is ever sent
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@loopcasts.example

# AI provider for the n8n payment-matching step (Phase 4) — fill in ONE of these
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
